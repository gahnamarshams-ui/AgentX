# Backend only. Empty key permits task management; planning returns a clear 503.
OPENAI_API_KEY=your_openai_api_key_here
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_PATH=data/agentx.sqlite3
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45

# Local-only execution is opt-in. Use a dedicated directory, never your repository root.
EXECUTION_ENABLED=false
WORKSPACE_PATH=workspace
EXECUTION_MAX_ATTEMPTS=2
EXECUTION_LEASE_SECONDS=120

PYTHON_EXECUTION_ENABLED=false
